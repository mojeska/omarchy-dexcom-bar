#!/usr/bin/env python3
"""Fetch the latest Dexcom Share glucose reading and print it as JSON.

Reads username/region/thresholds from ~/.config/omarchy/dexcom.json:
  {
    "username": "...",
    "region": "us" | "ous",
    "highThreshold": 180,
    "lowThreshold": 70
  }

The password is not stored in this file -- it lives in the system keyring
(Secret Service, via `secret-tool`) instead. A config file left over from
before this was the case (with a plaintext "password" key) is read once,
migrated into the keyring, and rewritten without that key.

Prints one JSON object to stdout, always exit 0 so the caller can just
parse stdout rather than branch on exit code:
  {"ok": true, "mgdl": 118, "trend": "Flat", "trendArrow": "→",
   "level": "normal", "minutesAgo": 3}
  {"ok": false, "error": "not configured"}

Two extra CLI modes support the bar widget's setup panel:
  --get-config   Print {username, region, highThreshold, lowThreshold,
                 hasPassword} -- never the password itself.
  --set-config   Read one JSON object from stdin (same shape, plus an
                 optional "password") and persist it -- non-secret fields
                 to dexcom.json, password (if sent) to the keyring. Prints
                 {"ok": true} or {"ok": false, "error": "..."}.
"""

import json
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

CONFIG_PATH = Path.home() / ".config" / "omarchy" / "dexcom.json"
STATE_PATH = Path.home() / ".local" / "state" / "omarchy" / "dexcom-status.json"

# Fixed Secret Service attributes for the stored password -- not tied to the
# username, so changing the username later doesn't orphan the stored secret.
SECRET_SERVICE = "omarchy-dexcom-bar"
SECRET_ACCOUNT = "dexcom-share"

# Dexcom Share error codes that mean the credentials themselves are wrong,
# as opposed to a transient network/server problem. Repeatedly retrying
# these looks like a brute-force attempt from Dexcom's side, so after a few
# in a row we stop hitting the API until the config file is actually edited.
AUTH_ERROR_CODES = {
    "AccountPasswordInvalid",
    "AccountPasswordInvalidLegacy",
    "SSO_AuthenticateAccountNotFound",
    "SSO_AuthenticateMaxAttemptsExceeded",
    "AccountNotFound",
    "AccountLockedOut",
    "InvalidArgument",
}
MAX_CONSECUTIVE_AUTH_FAILURES = 3

# Same application id every Dexcom Share client (pydexcom, xDrip, Nightscout
# bridges) registers with -- Dexcom Share has no public app-registration flow.
APPLICATION_ID = "d8665ade-9673-4e27-9ff6-92db4ce13d13"

BASE_URLS = {
    "us": "https://share2.dexcom.com/ShareWebServices/Services",
    "ous": "https://shareous1.dexcom.com/ShareWebServices/Services",
}

TREND_ARROWS = {
    "DoubleUp": "↑↑",
    "SingleUp": "↑",
    "FortyFiveUp": "↗",
    "Flat": "→",
    "FortyFiveDown": "↘",
    "SingleDown": "↓",
    "DoubleDown": "↓↓",
    "NotComputable": "?",
    "RateOutOfRange": "?",
}

TIMEOUT = 8


def emit(payload):
    print(json.dumps(payload))
    sys.exit(0)


def normalize_username(username, region):
    # A bare 10-digit US number is rejected by Dexcom Share unless it carries
    # the country code -- confirmed against a real account that this alone
    # produces the same generic AccountPasswordInvalid error as an actually
    # wrong password, with no other symptom to tell them apart.
    stripped = username.strip()
    if region == "us" and re.fullmatch(r"\d{10}", stripped):
        return "+1" + stripped
    return username


def keyring_get_password():
    try:
        result = subprocess.run(
            ["secret-tool", "lookup", "service", SECRET_SERVICE, "account", SECRET_ACCOUNT],
            capture_output=True, text=True, timeout=TIMEOUT,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if result.returncode != 0:
        return None
    password = result.stdout.rstrip("\n")
    return password if password else None


def keyring_set_password(password):
    try:
        result = subprocess.run(
            [
                "secret-tool", "store", "--label=Dexcom Share (omarchy-dexcom-bar)",
                "service", SECRET_SERVICE, "account", SECRET_ACCOUNT,
            ],
            input=password, capture_output=True, text=True, timeout=TIMEOUT,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return result.returncode == 0


def load_config():
    try:
        raw = CONFIG_PATH.read_text(encoding="utf-8")
    except OSError:
        return None
    try:
        config = json.loads(raw)
    except json.JSONDecodeError:
        return None
    if isinstance(config, dict) and isinstance(config.get("username"), str):
        config["username"] = normalize_username(config["username"], str(config.get("region", "us")).lower())
    return config


def post_json(url, body):
    data = json.dumps(body).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=data,
        method="POST",
        headers={"Content-Type": "application/json", "Accept": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
        return json.loads(resp.read().decode("utf-8"))


def parse_dexcom_date(value):
    match = re.search(r"\((\d+)", str(value or ""))
    if not match:
        return None
    return int(match.group(1)) / 1000.0


def load_state():
    try:
        return json.loads(STATE_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {"consecutiveAuthFailures": 0, "configMtime": None}


def save_state(state):
    try:
        STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
        STATE_PATH.write_text(json.dumps(state), encoding="utf-8")
    except OSError:
        pass


def dexcom_error_code(http_error):
    try:
        body = json.loads(http_error.read().decode("utf-8", errors="replace"))
        return str(body.get("Code", ""))
    except (json.JSONDecodeError, OSError, AttributeError):
        return ""


def main():
    config = load_config()
    if not config or not config.get("username"):
        emit({"ok": False, "error": "not configured"})

    password = config.get("password")
    if password:
        # Config left over from before the password moved to the keyring --
        # use it for this run, and migrate it out of the file so it doesn't
        # keep sitting there in plaintext.
        if keyring_set_password(password):
            try:
                migrated = {k: v for k, v in config.items() if k != "password"}
                CONFIG_PATH.write_text(json.dumps(migrated, indent=2) + "\n", encoding="utf-8")
                CONFIG_PATH.chmod(0o600)
            except OSError:
                pass
    else:
        password = keyring_get_password()

    if not password:
        emit({"ok": False, "error": "not configured"})

    config_mtime = CONFIG_PATH.stat().st_mtime
    state = load_state()
    if state.get("configMtime") != config_mtime:
        state = {"consecutiveAuthFailures": 0, "configMtime": config_mtime}
        save_state(state)

    if state.get("consecutiveAuthFailures", 0) >= MAX_CONSECUTIVE_AUTH_FAILURES:
        emit({
            "ok": False,
            "error": "login rejected repeatedly -- update your Dexcom credentials in the widget to retry",
        })

    region = str(config.get("region", "us")).lower()
    base_url = BASE_URLS.get(region, BASE_URLS["us"])
    high = config.get("highThreshold", 180)
    low = config.get("lowThreshold", 70)

    def record_auth_failure(reason):
        state["consecutiveAuthFailures"] = state.get("consecutiveAuthFailures", 0) + 1
        state["configMtime"] = config_mtime
        save_state(state)
        emit({"ok": False, "error": "login failed: " + reason})

    # Two-step login: AuthenticatePublisherAccount resolves the account name
    # to an internal account id, then LoginPublisherAccountById exchanges
    # that id + password for a session id. The older single-step
    # LoginPublisherAccountByName call is unreliable for some accounts even
    # with a correct password.
    try:
        account_id = post_json(
            base_url + "/General/AuthenticatePublisherAccount",
            {
                "accountName": config["username"],
                "password": password,
                "applicationId": APPLICATION_ID,
            },
        )
    except urllib.error.HTTPError as e:
        code = dexcom_error_code(e)
        if code in AUTH_ERROR_CODES:
            record_auth_failure(code)
        emit({"ok": False, "error": "authenticate failed (HTTP " + str(e.code) + (": " + code if code else "") + ")"})
    except (urllib.error.URLError, TimeoutError, OSError):
        emit({"ok": False, "error": "authenticate failed (network)"})
    except json.JSONDecodeError:
        emit({"ok": False, "error": "authenticate failed (bad response)"})

    if not account_id or account_id == "00000000-0000-0000-0000-000000000000":
        record_auth_failure("empty account id")

    try:
        session_id = post_json(
            base_url + "/General/LoginPublisherAccountById",
            {
                "accountId": account_id,
                "password": password,
                "applicationId": APPLICATION_ID,
            },
        )
    except urllib.error.HTTPError as e:
        code = dexcom_error_code(e)
        if code in AUTH_ERROR_CODES:
            record_auth_failure(code)
        emit({"ok": False, "error": "login failed (HTTP " + str(e.code) + (": " + code if code else "") + ")"})
    except (urllib.error.URLError, TimeoutError, OSError):
        emit({"ok": False, "error": "login failed (network)"})
    except json.JSONDecodeError:
        emit({"ok": False, "error": "login failed (bad response)"})

    if not session_id or session_id == "00000000-0000-0000-0000-000000000000":
        record_auth_failure("empty session")

    if state.get("consecutiveAuthFailures", 0) > 0:
        save_state({"consecutiveAuthFailures": 0, "configMtime": config_mtime})

    try:
        readings = post_json(
            base_url + "/Publisher/ReadPublisherLatestGlucoseValues",
            {"sessionId": session_id, "minutes": 1440, "maxCount": 1},
        )
    except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError, OSError):
        emit({"ok": False, "error": "reading fetch failed (network)"})
    except json.JSONDecodeError:
        emit({"ok": False, "error": "reading fetch failed (bad response)"})

    if not readings:
        emit({"ok": False, "error": "no recent readings"})

    latest = readings[0]
    mgdl = latest.get("Value")
    trend = latest.get("Trend", "")
    timestamp = parse_dexcom_date(latest.get("WT"))
    minutes_ago = int((time.time() - timestamp) / 60) if timestamp else None

    if mgdl is None:
        emit({"ok": False, "error": "no glucose value in reading"})

    level = "high" if mgdl >= high else "low" if mgdl <= low else "normal"

    emit({
        "ok": True,
        "mgdl": mgdl,
        "trend": trend,
        "trendArrow": TREND_ARROWS.get(trend, ""),
        "level": level,
        "minutesAgo": minutes_ago,
    })


def cmd_get_config():
    config = load_config() or {}
    password = config.get("password") or keyring_get_password()
    emit({
        "username": config.get("username", ""),
        "region": str(config.get("region", "us")).lower(),
        "highThreshold": config.get("highThreshold", 180),
        "lowThreshold": config.get("lowThreshold", 70),
        "hasPassword": bool(password),
    })


def cmd_set_config():
    try:
        payload = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        emit({"ok": False, "error": "bad request (invalid JSON)"})

    if not isinstance(payload, dict):
        emit({"ok": False, "error": "bad request (expected an object)"})

    username = str(payload.get("username", "")).strip()
    if not username:
        emit({"ok": False, "error": "username is required"})

    region = str(payload.get("region", "us")).lower()
    if region not in BASE_URLS:
        region = "us"

    try:
        high = int(payload.get("highThreshold", 180))
        low = int(payload.get("lowThreshold", 70))
    except (TypeError, ValueError):
        emit({"ok": False, "error": "thresholds must be numbers"})

    password = payload.get("password")
    if password:
        if not keyring_set_password(str(password)):
            emit({"ok": False, "error": "couldn't save password to the system keyring"})

    config = {
        "username": username,
        "region": region,
        "highThreshold": high,
        "lowThreshold": low,
    }
    try:
        CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
        CONFIG_PATH.write_text(json.dumps(config, indent=2) + "\n", encoding="utf-8")
        CONFIG_PATH.chmod(0o600)
    except OSError as e:
        emit({"ok": False, "error": "couldn't write config: " + str(e)})

    emit({"ok": True})


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--get-config":
        cmd_get_config()
    elif len(sys.argv) > 1 and sys.argv[1] == "--set-config":
        cmd_set_config()
    else:
        main()
